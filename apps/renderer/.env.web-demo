# إعدادات Vite لوضع web-demo (تُقرأ عند التشغيل بـ --mode web-demo).
# متغيرات VITE_* فقط هي التي تصل إلى المتصفح — لا تضع هنا أي سر.

# API الخاص بوضع العرض (منفذ مستقل عن نسخة سطح المكتب).
VITE_API_BASE_URL=http://127.0.0.1:45699/api

# يفعّل طبقة platform/web بدل جسر Electron.
VITE_WEB_DEMO=true

# يفعّل مؤشّر التصوير وتهدئة الحركة داخل الصفحة.
VITE_CAPTURE_MODE=true
