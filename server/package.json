{
  "name": "@dalaly/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "tsx --test scripts/startup.test.ts scripts/setup-security.test.ts scripts/login-throttle.test.ts scripts/remote-access-lifecycle.test.ts scripts/postgres-errors.test.ts scripts/error-shape.test.ts scripts/json-file.test.ts scripts/location.test.ts scripts/renderer-utils.test.ts scripts/contract-document.test.ts scripts/money.test.ts scripts/deal-rules.test.ts scripts/accounting-rules.test.ts scripts/journal-rules.test.ts scripts/voucher-rules.test.ts",
    "test:startup": "tsx --test scripts/startup.test.ts scripts/setup-security.test.ts",
    "test:startup:electron": "node scripts/startup-electron.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsup",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "db:seed:reset": "tsx src/infrastructure/database/seed.ts --reset",
    "db:generate": "drizzle-kit generate",
    "test:maps": "tsx --test scripts/location.test.ts scripts/renderer-utils.test.ts",
    "test:maps:runtime": "tsx scripts/location-smoke.ts",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:runtime:phase1": "node scripts/runtime-smoke-phase1.mjs",
    "test:runtime:phase2": "node scripts/runtime-smoke-phase2.mjs",
    "test:runtime:phase3": "node scripts/runtime-smoke-phase3.mjs",
    "test:runtime:phase4": "node scripts/runtime-smoke-phase4.mjs",
    "test:runtime:phase5": "node scripts/runtime-smoke-phase5.mjs",
    "test:runtime:spaces": "node scripts/runtime-smoke-spaces.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "format": "npx prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:removal:browser": "tsx scripts/removal-browser.ts",
    "test:removal:electron": "tsx scripts/removal-package-smoke.ts",
    "test:removal:backup": "tsx --test scripts/removal-backup.test.ts",
    "test:restore:large": "tsx --test scripts/backup-restore-large.test.ts",
    "test:backup:safety": "tsx --test scripts/backup-safety.test.ts",
    "test:backup:compat": "tsx --test scripts/backup-compat.test.ts",
    "test:backup:retention": "tsx --test scripts/backup-retention.test.ts",
    "test:backup:encrypted": "tsx --test scripts/backup-encrypted.test.ts",
    "test:permissions": "tsx --test scripts/permissions-scope.test.ts",
    "test:remote-access": "tsx --test scripts/remote-access.test.ts",
    "test:limits": "tsx --test scripts/request-limits.test.ts",
    "test:media-tokens": "tsx --test scripts/media-tokens.test.ts",
    "test:hardening": "tsx --test scripts/hardening.test.ts",
    "test:codes": "tsx --test scripts/record-codes.test.ts",
    "test:transactions": "tsx --test scripts/transactions.test.ts",
    "test:paging": "tsx --test scripts/list-paging.test.ts scripts/crm-paging.test.ts",
    "test:thumbnails": "tsx --test scripts/thumbnails.test.ts",
    "test:files": "tsx --test scripts/file-integrity.test.ts",
    "test:tasks": "tsx --test scripts/crm-tasks.test.ts",
    "test:customers": "tsx --test scripts/customer-crm.test.ts",
    "test:deals": "tsx --test scripts/deals.test.ts",
    "test:accounting": "tsx --test scripts/accounting.test.ts",
    "test:ledger": "tsx --test scripts/ledger.test.ts",
    "test:vouchers": "tsx --test scripts/vouchers.test.ts",
    "test:import": "tsx --test scripts/import-commit.test.ts",
    "test:queries": "tsx --test scripts/list-queries.test.ts",
    "test:dashboard": "tsx --test scripts/dashboard-summary.test.ts",
    "test:dashboard:operations": "tsx --test scripts/dashboard-operations.test.ts",
    "test:timeouts": "tsx --test scripts/statement-timeout.test.ts",
    "test:search": "tsx --test scripts/search-text.test.ts",
    "test:contract": "tsx --test scripts/api-contract.test.ts",
    "test:agreements": "tsx --test scripts/agreements.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "adm-zip": "0.5.17",
    "drizzle-kit": "^0.31.8",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
