# ==========================================================================
# وضع web-demo — تشغيل دلالي كنسخة ويب محلية لأغراض التصوير فقط.
#
#   pnpm dev:web        يشغّل الـ API + Vite في هذا الوضع
#   pnpm demo:reset     يعيد بناء قاعدة العرض من الصفر
#
# لا يُستخدم هذا الملف في نسخة Electron ولا في الإنتاج.
# لا تضع فيه أي سر حقيقي: بيانات الاتصال بقاعدة البيانات المحلية تُقرأ من
# ملف .env الموجود على جهاز المطوّر (يُحمَّل بعد هذا الملف ولا يطغى عليه).
# ==========================================================================

WEB_DEMO_MODE=true

# قاعدة بيانات معزولة تماماً عن قاعدة التطوير (dalaly) وعن أي قاعدة إنتاج.
DB_NAME=dalaly_demo
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# DB_PASSWORD يأتي من .env المحلي — لا تكتبه هنا.

# منفذ API مستقل حتى لا يتعارض مع نسخة سطح المكتب (45678).
API_HOST=127.0.0.1
API_PORT=45699

# مجلد بيانات العرض (صور + نسخ احتياطية) — منفصل عن بيانات التطوير.
APP_DATA_DIR=data/web-demo

# منشأ الويب المسموح به في CORS (منفذ Vite الخاص بوضع العرض).
CORS_ORIGINS=http://127.0.0.1:5199,http://localhost:5199

# حساب التصوير. يُنشأ آلياً عند pnpm demo:reset ويُستخدم محلياً فقط.
# القيود في النظام: PIN من 4 إلى 12 خانة، لذلك ليس كلمة مرور طويلة.
ADMIN_USERNAME=demo.admin
ADMIN_PIN=246810

SESSION_TTL_HOURS=12
REMOTE_ACCESS_ENABLED=false
APP_VERSION=0.1.0
